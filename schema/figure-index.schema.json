{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PeterPonyu/calibration-traps/schema/figure-index.schema.json",
  "title": "Paper warehouse FIGURE-INDEX",
  "type": "object",
  "required": ["paper_id", "github", "zenodo_concept_doi", "pipeline", "figures"],
  "additionalProperties": false,
  "properties": {
    "paper_id": {
      "type": "string",
      "enum": ["A", "B", "C", "E1", "E2"]
    },
    "github": {
      "type": "string",
      "pattern": "^PeterPonyu/[A-Za-z0-9._-]+$"
    },
    "zenodo_concept_doi": {
      "type": "string",
      "pattern": "^10\\.5281/zenodo\\.[0-9]+$"
    },
    "pipeline": {
      "type": "string"
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "generator",
          "summary",
          "preview_svg",
          "tex_build",
          "vec_build",
          "venue_flat_name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "generator": {"type": "string"},
          "summary": {"type": ["string", "null"]},
          "preview_svg": {"type": ["string", "null"]},
          "tex_build": {"type": ["string", "null"]},
          "vec_build": {"type": ["string", "null"]},
          "venue_flat_name": {"type": ["string", "null"]}
        }
      }
    }
  }
}
